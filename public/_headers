# Cloudflare Pages headers. Copied verbatim into dist/ by `expo export`.

# Metro fingerprints these filenames, so they can be cached forever.
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML shells must not be cached hard, or a deploy won't be picked up.
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
