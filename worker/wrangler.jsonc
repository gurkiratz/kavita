{
  // Kavita admin Worker: serves the add-poem form and writes to the R2 bucket.
  // Deploy:  cd worker && npx wrangler deploy
  // Set the password (one-time):  npx wrangler secret put ADMIN_TOKEN
  "name": "kavita-admin",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",
  "observability": { "enabled": true },
  // Public base URL of the R2 bucket — used to render existing-poem thumbnails.
  "vars": {
    "R2_PUBLIC_BASE": "https://pub-4730074c0ff04638961b0cf1c2d55537.r2.dev"
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "kavita",
      // Used by `wrangler dev --remote` so remote testing can never write to the
      // real collection. Create it once: `npx wrangler r2 bucket create kavita-dev`.
      "preview_bucket_name": "kavita-dev"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/config", "/poems", "/poem", "/poem/*", "/scans/*"]
  }
}
